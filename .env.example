# Every secret the project needs, with no values. Copy to .env and fill in.
# How to get each one is in docs/SETUP.md.

# Optional: force a provider ("auto", "nvidia", or "anthropic"). Default: auto
# (prefers NVIDIA_API_KEY if set, else ANTHROPIC_API_KEY, else offline demo story).
AI_PROVIDER=

# NVIDIA NIM API key - build.nvidia.com > API Keys.
NVIDIA_API_KEY=
# Optional, not secret (default: nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Anthropic API key - console.anthropic.com > API Keys. Without any AI key the app
# runs the built-in offline story only.
ANTHROPIC_API_KEY=

# Optional, not secret: Claude model and effort (defaults: claude-opus-5-5, low)
CLAUDE_MODEL=
CLAUDE_EFFORT=
